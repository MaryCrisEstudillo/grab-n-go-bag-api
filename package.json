{
  "name": "grabngo-bag-api",
  "private": true,
  "version": "0.1.0",
  "description": "GrabnGo bag API — sessions, categories and items for the emergency-kit tracker.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "serverless offline start",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:check": "tsx --env-file-if-exists=.env scripts/check-db.ts",
    "email:test": "tsx --env-file-if-exists=.env scripts/send-test-email.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "serverless deploy"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.0",
    "serverless-offline": "^13.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
