# Copy to `.env` and fill in.

# ─── Database ────────────────────────────────────────────────────────────────
# Local, matching docker-compose.yml:
DATABASE_URL=postgres://grabngo:grabngo@localhost:5432/grabngo

# Hosted (Neon), use the POOLED string — its host contains `-pooler`. The
# pooler is what makes this safe to call from Lambda, where every warm
# container would otherwise hold its own connection:
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Optional, and only read by `npm run migrate`. Neon's direct (non-pooler)
# string — DDL belongs on a real connection, not through a transaction pooler.
# DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
# Sign the session tokens. Any long random string locally; a real secret from
# Secrets Manager or SSM once this is deployed anywhere.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-something-long-and-random

# How long a session lasts. Accepts the vercel/ms format.
JWT_EXPIRES_IN=30d

# ─── HTTP ────────────────────────────────────────────────────────────────────
# The frontend origins allowed to call this. `*` is fine while it's local only.
# Accepts a comma-separated list, so the deployed site and a local dev server
# can both be allowed without editing this between runs:
#   CORS_ORIGIN=https://you.github.io,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Where the emails link back to, and where the unsubscribe page lives.
APP_URL=http://localhost:3000

# ─── Email ───────────────────────────────────────────────────────────────────
# Both optional. Without them the daily digest job runs, logs how many people
# it would have mailed, and sends nothing — so nothing is blocked on setting
# this up.
#
# Sent through Gmail's SMTP, so no domain is needed. GMAIL_APP_PASSWORD is a
# 16-character app password from myaccount.google.com/apppasswords, NOT your
# Google account password. It needs 2-Step Verification switched on first.
#
# Use a throwaway Gmail rather than your main one: an app password bypasses
# 2FA for mail, so it shouldn't sit on an account holding anything important.
# GMAIL_USER=yourapp@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# The display name recipients see. The address itself is always GMAIL_USER —
# Gmail only lets you send as the account you authenticated with.
# Quoted because it contains a space: nothing in this project sources .env with
# a shell, but `. ./.env` would otherwise read "bag" as a command.
EMAIL_FROM_NAME="GrabnGo App"
