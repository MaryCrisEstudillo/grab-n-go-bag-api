# Copy to `.env` and fill in.

# ─── Database ────────────────────────────────────────────────────────────────
# Local, matching docker-compose.yml:
DATABASE_URL=postgres://grabngo:grabngo@localhost:5432/grabngo

# Hosted (Neon), use the POOLED string — its host contains `-pooler`. The
# pooler is what makes this safe to call from Lambda, where every warm
# container would otherwise hold its own connection:
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Optional, and only read by `npm run migrate`. Neon's direct (non-pooler)
# string — DDL belongs on a real connection, not through a transaction pooler.
# DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
# Sign the session tokens. Any long random string locally; a real secret from
# Secrets Manager or SSM once this is deployed anywhere.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-something-long-and-random

# How long a session lasts. Accepts the vercel/ms format.
JWT_EXPIRES_IN=30d

# ─── HTTP ────────────────────────────────────────────────────────────────────
# The frontend origin allowed to call this. `*` is fine while it's local only.
CORS_ORIGIN=http://localhost:3000

# Where the emails link back to, and where the unsubscribe page lives.
APP_URL=http://localhost:3000

# ─── Email ───────────────────────────────────────────────────────────────────
# Both optional. Without them the daily digest job runs, logs how many people
# it would have mailed, and sends nothing — so the API works fine before a
# sending domain exists.
#
# EMAIL_FROM must be on a domain verified in Resend, or Gmail will treat it as
# forged no matter what the key says.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=GrabnGo bag <reminders@yourdomain.com>
